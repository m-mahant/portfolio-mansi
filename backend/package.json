{
  "name": "mansi-mahant-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').accessSync('src/server.ts')\"",
    "start": "tsx src/server.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "seed:firebase-content": "tsx scripts/seed-firebase-content.ts",
    "seed:imagekit-media": "tsx scripts/seed-imagekit-media.ts",
    "backup:firestore": "tsx scripts/backup-firestore.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@imagekit/nodejs": "^7.11.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.19",
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0",
    "multer": "^2.3.0",
    "resend": "^6.34.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "supertest": "^7.2.2"
  }
}
