# Backend — copy to .env (never commit real values).
# On Render, do not set PORT; the platform provides it.

FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=4000

# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ImageKit dashboard → Developer options
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional: used only by `npm run bootstrap:admin`
# BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Optional: contact form email notifications (Resend — https://resend.com)
# Leave unset to disable; the form still saves to Firestore either way.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
